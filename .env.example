# my-neuro environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── SiliconFlow (cloud TTS / shared API key) ──────────────────────────────────
SILICONFLOW_API_KEY=

# ── Aliyun TTS (optional) ─────────────────────────────────────────────────────
ALIYUN_TTS_API_KEY=

# ── Cloud TTS custom voice ID (SiliconFlow CosyVoice) ─────────────────────────
CLOUD_TTS_VOICE=speech:fake-neuro:j3qz9ij4k2:kquiiycgizgaoxeujypx

# ── Vision model (optional) ───────────────────────────────────────────────────
VISION_API_KEY=
VISION_API_URL=
VISION_MODEL=

# ── API Gateway (optional) ────────────────────────────────────────────────────
API_GATEWAY_API_KEY=

# ── Baidu ASR (optional) ──────────────────────────────────────────────────────
BAIDU_ASR_APPKEY=

# ── MemOS LLM (memos_config.json) ─────────────────────────────────────────────
# Primary: DeepSeek via SiliconFlow (reuses SILICONFLOW_API_KEY above)
OPENROUTER_API_KEY=

# ── MemOS Feature Toggles ─────────────────────────────────────────────────────
# Entity extraction: MemOS LLM extracts named entities from each stored memory
# and builds a NetworkX knowledge graph. Needs a working LLM API key above.
# Adds ~1-2 s latency per store call. Disable if LLM key is unavailable.
MEMOS_ENTITY_EXTRACTION_ENABLED=true
MEMOS_ENTITY_AUTO_EXTRACT=true

# Knowledge-graph score boost during search. Only useful once entity extraction
# has been running long enough to populate the graph.
MEMOS_GRAPH_ENABLED=true

# Image memory: store and search images inside MemOS (file-based + vector).
MEMOS_IMAGE_ENABLED=true
# Auto-generate a text description for each uploaded image via the LLM.
# Set false if no LLM key is available; MemOS will fall back to the filename.
MEMOS_IMAGE_AUTO_DESCRIBE=true
# Use CLIP visual embeddings instead of text-description embeddings for images.
# Provides true visual similarity search but requires the CLIP model downloaded.
MEMOS_IMAGE_USE_CLIP=false
MEMOS_IMAGE_MAX_SIZE_MB=5

# ── MemOS Search Tuning ────────────────────────────────────────────────────────
MEMOS_BM25_ENABLED=true
MEMOS_BM25_WEIGHT=0.3           # fraction of final score from BM25 (rest is vector)
MEMOS_SIMILARITY_THRESHOLD=0.5  # minimum score to return a result
MEMOS_DEFAULT_TOP_K=5
MEMOS_GRAPH_MAX_DEPTH=2         # hops in the knowledge graph to boost
